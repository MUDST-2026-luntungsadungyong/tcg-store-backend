# Copy to .env and fill the Neon values. This single file supports both
# docker compose (local PostgreSQL) and docker-compose.neon.yml (Neon).

# Neon CLI values for the linked production branch
DATABASE_URL=postgresql://<neon-user>:<neon-password>@<neon-host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://<neon-user>:<neon-password>@<neon-host>/<database>?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Active cloud runtime (Spring Boot + Neon)
SPRING_PROFILES_ACTIVE=neon
NEON_JDBC_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require&channel_binding=require
NEON_DB_USERNAME=<neon-user>
NEON_DB_PASSWORD=<neon-password>
NEON_POOL_MAX_SIZE=5
NEON_POOL_MIN_IDLE=0
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_JWT_SECRET=change-this-development-only-secret-key-to-a-secure-32-byte-value
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_JWT_EXPIRATION_MINUTES=1440
SELLER_PRODUCT_IMAGE_DIR=uploads/products
APP_LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# Local Docker PostgreSQL runtime
DB_URL=jdbc:postgresql://localhost:5432/tcg_store
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=tcg_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=3000
