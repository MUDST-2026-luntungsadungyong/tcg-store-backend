# Copy this file to .env. It is the only environment file used by the project.
# Replace placeholder values locally; never commit .env or real credentials.
# Compose selects the runtime. For direct Spring runs, set SPRING_PROFILES_ACTIVE
# in the process environment (dev for local PostgreSQL, neon for Neon).

# Neon CLI values for the shared development branch
DATABASE_URL=postgresql://<neon-user>:<neon-password>@<neon-host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://<neon-user>:<neon-password>@<neon-host>/<database>?sslmode=require&channel_binding=require
NEON_BRANCH=development

# Default direct-Spring profile for the cloud connection settings below.
# Docker Compose still selects its own runtime explicitly.
SPRING_PROFILES_ACTIVE=neon
NEON_JDBC_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require&channelBinding=require
NEON_DB_USERNAME=<neon-user>
NEON_DB_PASSWORD=<neon-password>
NEON_POOL_MAX_SIZE=5
NEON_POOL_MIN_IDLE=0
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_EXPIRATION_MINUTES=1440
# Required by the cloud backend. Local Docker overrides these values and starts
# S3Mock automatically. Neon env pull supplies the endpoint and credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-2
OBJECT_STORAGE_BUCKET=tcg-product-images
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
APP_LOG_LEVEL=INFO
JPA_SHOW_SQL=false
# API containers keep Flyway off; the dedicated migration service/Job overrides it.
FLYWAY_ENABLED=false
# Transitional adoption for databases created before Flyway. Set false after every
# persistent environment has a flyway_schema_history baseline.
FLYWAY_BASELINE_ON_MIGRATE=true

# Local Docker PostgreSQL runtime
DB_URL=jdbc:postgresql://localhost:5432/tcg_store
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=tcg_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=3000

# Optional TiDB validation profile
TIDB_JDBC_URL=jdbc:mysql://<tidb-host>:4000/tcg_store_revision5?sslMode=VERIFY_IDENTITY&tlsVersions=TLSv1.2,TLSv1.3&serverTimezone=UTC
TIDB_USER=replace-with-tidb-user
TIDB_PASSWORD=replace-with-generated-password
TIDB_POOL_MAX_SIZE=5
TIDB_POOL_MIN_IDLE=0
TIDB_SQL_LOG_LEVEL=WARN
