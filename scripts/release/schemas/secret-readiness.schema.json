{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcg-store-backend.invalid/schemas/secret-readiness-v1.json",
  "title": "Platform operator secret readiness contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "issuer", "environment", "namespace", "secretName", "keyNames", "checkedAt", "ready"],
  "properties": {
    "schemaVersion": {"const": 1},
    "issuer": {"const": "platform-operator"},
    "environment": {"enum": ["staging", "production"]},
    "namespace": {"type": "string", "pattern": "^tcg-store-(staging|production)$"},
    "secretName": {"const": "tcg-store-backend-secrets"},
    "keyNames": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "minItems": 1},
    "checkedAt": {"type": "string", "format": "date-time"},
    "ready": {"const": true}
  }
}
